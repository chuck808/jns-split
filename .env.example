# Optional: leave unset to use only the bench simulator.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Publishable key, or legacy anon JWT. NEVER a secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: invitation emails to coaches and families. Leave unset and the app
# shows "no email sent" and you pass invitations on yourself. Use the same SMTP
# details you gave Supabase (see docs/email-and-sign-up-setup.md).
APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
