    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
